# ==========================================
# E-Wardrobe Environment Configuration
# ==========================================

# 1. AI Provider Selection
# Options: "gemini" | "groq" | "openai"
# Default: Automatically chooses whichever key is provided below
AI_PROVIDER=gemini

# 2. AI Model (Optional override)
# - For Gemini: gemini-1.5-flash or gemini-2.0-flash
# - For Groq: openai/gpt-oss-20b or llama-3.3-70b-versatile
# - For OpenAI: gpt-4o-mini
# GEMINI_MODEL=gemini-1.5-flash
# GROQ_MODEL=openai/gpt-oss-20b
# OPENAI_MODEL=gpt-4o-mini

# 3. API Keys (Fill the one you want to use)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 4. Cloudinary Cloud Image Storage (Free Tier)
# Get these from your Cloudinary dashboard: https://cloudinary.com
# If left empty, photos will be compressed and stored in the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 5. Local Server Port
PORT=3000

# 6. Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
